{
  "$schema": "vscode://schemas/color-theme",
  "name": "Claude Cream High Contrast",
  "type": "light",
  "include": "./claude-cream-color-theme.json",
  "colors": {
    "contrastActiveBorder": "#7c4f0e",
    "contrastBorder": "#8a7d65",
    "focusBorder": "#7c4f0e",
    "foreground": "#29271d",
    "descriptionForeground": "#4c463b",
    "selection.background": "#d9bd84",
    "editor.background": "#fffdf7",
    "editor.foreground": "#29271d",
    "editor.lineHighlightBackground": "#eee8dc",
    "editor.selectionBackground": "#d9bd84",
    "editor.inactiveSelectionBackground": "#e2cfaa",
    "editorCursor.foreground": "#7c4f0e",
    "editorGroup.border": "#8a7d65",
    "editorGroupHeader.tabsBorder": "#8a7d65",
    "tab.activeBackground": "#fffdf7",
    "tab.activeForeground": "#29271d",
    "tab.activeBorderTop": "#7c4f0e",
    "tab.inactiveBackground": "#f0eee6",
    "tab.inactiveForeground": "#4c463b",
    "sideBar.background": "#f0eee6",
    "sideBar.foreground": "#29271d",
    "sideBar.border": "#8a7d65",
    "activityBar.background": "#e8e3d7",
    "activityBar.foreground": "#29271d",
    "activityBar.inactiveForeground": "#6d675b",
    "activityBar.activeBorder": "#7c4f0e",
    "list.activeSelectionBackground": "#d5ccbb",
    "list.activeSelectionForeground": "#29271d",
    "list.focusBackground": "#e2cfaa",
    "list.focusOutline": "#7c4f0e",
    "statusBar.background": "#e8e3d7",
    "statusBar.foreground": "#29271d",
    "statusBar.border": "#8a7d65",
    "panel.background": "#fffdf7",
    "panel.border": "#8a7d65",
    "terminal.background": "#fffdf7",
    "terminal.foreground": "#29271d",
    "terminal.selectionBackground": "#d9bd84",
    "editorError.foreground": "#68130d",
    "editorWarning.foreground": "#75400e",
    "gitDecoration.addedResourceForeground": "#31551c",
    "gitDecoration.modifiedResourceForeground": "#75400e",
    "gitDecoration.deletedResourceForeground": "#68130d",
    "diffEditor.insertedLineBackground": "#c3ddba80",
    "diffEditor.insertedTextBackground": "#c3ddbab3",
    "diffEditor.removedLineBackground": "#e9bbb580",
    "diffEditor.removedTextBackground": "#e9bbb5b3"
  },
  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#625b50", "fontStyle": "italic" } },
    { "scope": ["string", "constant.other.symbol", "markup.inline.raw"], "settings": { "foreground": "#405d1f", "background": "#fffdf7" } },
    { "scope": ["constant.numeric", "constant.language", "constant.character"], "settings": { "foreground": "#75400e" } },
    { "scope": ["keyword", "storage.type", "storage.modifier"], "settings": { "foreground": "#5f2d72" } },
    { "scope": ["entity.name.function", "support.function", "meta.function-call"], "settings": { "foreground": "#754a0d" } },
    { "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class"], "settings": { "foreground": "#3c611b" } },
    { "scope": ["variable", "meta.definition.variable.name"], "settings": { "foreground": "#20242d" } },
    { "scope": ["keyword.operator"], "settings": { "foreground": "#373127" } },
    { "scope": ["punctuation"], "settings": { "foreground": "#494238" } },
    { "scope": ["entity.name.tag"], "settings": { "foreground": "#8a560d" } },
    { "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#3c611b" } }
  ],
  "semanticTokenColors": {
    "type": "#3c611b",
    "class": "#3c611b",
    "interface": "#3c611b",
    "parameter": "#20242d",
    "variable": "#20242d",
    "property": "#20242d",
    "function": "#754a0d",
    "method": "#754a0d",
    "keyword": "#5f2d72",
    "comment": { "foreground": "#625b50", "italic": true },
    "string": "#405d1f",
    "number": "#75400e",
    "operator": "#373127",
    "decorator": "#8a560d"
  }
}

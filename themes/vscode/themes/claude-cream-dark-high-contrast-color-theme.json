{
  "$schema": "vscode://schemas/color-theme",
  "name": "Claude Cream Dark High Contrast",
  "type": "dark",
  "include": "./claude-cream-dark-color-theme.json",
  "colors": {
    "contrastActiveBorder": "#f0cf92",
    "contrastBorder": "#8c887e",
    "focusBorder": "#f0cf92",
    "foreground": "#f8f7f2",
    "descriptionForeground": "#ddd9cd",
    "selection.background": "#806936",
    "editor.background": "#1f201f",
    "editor.foreground": "#f8f7f2",
    "editor.lineHighlightBackground": "#30312f",
    "editor.selectionBackground": "#806936",
    "editor.inactiveSelectionBackground": "#695735",
    "editorCursor.foreground": "#f0cf92",
    "editorGroup.border": "#8c887e",
    "editorGroupHeader.tabsBorder": "#8c887e",
    "tab.activeBackground": "#1f201f",
    "tab.activeForeground": "#f8f7f2",
    "tab.activeBorderTop": "#f0cf92",
    "tab.inactiveBackground": "#242524",
    "tab.inactiveForeground": "#bbb6a8",
    "sideBar.background": "#242524",
    "sideBar.foreground": "#f8f7f2",
    "sideBar.border": "#8c887e",
    "activityBar.background": "#242524",
    "activityBar.foreground": "#f8f7f2",
    "activityBar.inactiveForeground": "#bbb6a8",
    "activityBar.activeBorder": "#f0cf92",
    "list.activeSelectionBackground": "#69675f",
    "list.activeSelectionForeground": "#f8f7f2",
    "list.focusBackground": "#695735",
    "list.focusOutline": "#f0cf92",
    "statusBar.background": "#242524",
    "statusBar.foreground": "#f8f7f2",
    "statusBar.border": "#8c887e",
    "panel.background": "#1f201f",
    "panel.border": "#8c887e",
    "terminal.background": "#1f201f",
    "terminal.foreground": "#f8f7f2",
    "terminal.selectionBackground": "#806936",
    "editorError.foreground": "#ffaaa3",
    "editorWarning.foreground": "#f0cf92",
    "gitDecoration.addedResourceForeground": "#b0d68f",
    "gitDecoration.modifiedResourceForeground": "#f0cf92",
    "gitDecoration.deletedResourceForeground": "#ffaaa3",
    "diffEditor.insertedLineBackground": "#52654880",
    "diffEditor.insertedTextBackground": "#526548b3",
    "diffEditor.removedLineBackground": "#753f3980",
    "diffEditor.removedTextBackground": "#753f39b3"
  },
  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#a9ada5", "fontStyle": "italic" } },
    { "scope": ["string", "constant.other.symbol", "markup.inline.raw"], "settings": { "foreground": "#c8dc9d", "background": "#1f201f" } },
    { "scope": ["constant.numeric", "constant.language", "constant.character"], "settings": { "foreground": "#e8ad78" } },
    { "scope": ["keyword", "storage.type", "storage.modifier"], "settings": { "foreground": "#dba7e7" } },
    { "scope": ["entity.name.function", "support.function", "meta.function-call"], "settings": { "foreground": "#f0cf92" } },
    { "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class"], "settings": { "foreground": "#b0d68f" } },
    { "scope": ["variable", "meta.definition.variable.name"], "settings": { "foreground": "#f0ece2" } },
    { "scope": ["keyword.operator"], "settings": { "foreground": "#eee3d8" } },
    { "scope": ["punctuation"], "settings": { "foreground": "#d8d1c7" } },
    { "scope": ["entity.name.tag"], "settings": { "foreground": "#f0cf92" } },
    { "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#b0d68f" } }
  ],
  "semanticTokenColors": {
    "type": "#b0d68f",
    "class": "#b0d68f",
    "interface": "#b0d68f",
    "parameter": "#f0ece2",
    "variable": "#f0ece2",
    "property": "#f0ece2",
    "function": "#f0cf92",
    "method": "#f0cf92",
    "keyword": "#dba7e7",
    "comment": { "foreground": "#a9ada5", "italic": true },
    "string": "#c8dc9d",
    "number": "#e8ad78",
    "operator": "#eee3d8",
    "decorator": "#f0cf92"
  }
}

{
  "$schema": "vscode://schemas/color-theme",
  "name": "Claude Cream Dark Dimmed",
  "type": "dark",
  "include": "./claude-cream-dark-color-theme.json",
  "colors": {
    "focusBorder": "#d6b26f",
    "foreground": "#d2cec3",
    "descriptionForeground": "#aaa598",
    "selection.background": "#695d42",
    "editor.background": "#343533",
    "editor.foreground": "#d2cec3",
    "editor.lineHighlightBackground": "#3d3d3a",
    "editor.selectionBackground": "#695d42",
    "editor.inactiveSelectionBackground": "#5c5035",
    "editorCursor.foreground": "#d6b26f",
    "editorGroupHeader.tabsBackground": "#30312f",
    "editorGroupHeader.tabsBorder": "#4a4a45",
    "tab.activeBackground": "#343533",
    "tab.activeForeground": "#d2cec3",
    "tab.activeBorderTop": "#d6b26f",
    "tab.inactiveBackground": "#30312f",
    "tab.inactiveForeground": "#858177",
    "tab.hoverBackground": "#3d3d3a",
    "sideBar.background": "#30312f",
    "sideBar.foreground": "#d2cec3",
    "sideBar.border": "#4a4a45",
    "activityBar.background": "#30312f",
    "activityBar.foreground": "#d2cec3",
    "activityBar.inactiveForeground": "#858177",
    "activityBar.activeBorder": "#d6b26f",
    "list.activeSelectionBackground": "#55544f",
    "list.inactiveSelectionBackground": "#42423e",
    "list.hoverBackground": "#3d3d3a",
    "list.focusBackground": "#5c5035",
    "statusBar.background": "#30312f",
    "statusBar.foreground": "#aaa598",
    "statusBar.border": "#4a4a45",
    "titleBar.activeBackground": "#30312f",
    "titleBar.activeForeground": "#d2cec3",
    "panel.background": "#343533",
    "panel.border": "#4a4a45",
    "terminal.background": "#343533",
    "terminal.foreground": "#d2cec3",
    "terminalCursor.foreground": "#d6b26f",
    "terminal.selectionBackground": "#695d42",
    "diffEditor.insertedLineBackground": "#4b59444d",
    "diffEditor.insertedTextBackground": "#4b594480",
    "diffEditor.removedLineBackground": "#69413d4d",
    "diffEditor.removedTextBackground": "#69413d80",
    "peekViewEditor.background": "#343533",
    "peekViewResult.background": "#30312f"
  },
  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#a6aaa3", "fontStyle": "italic" } },
    { "scope": ["string", "constant.other.symbol", "markup.inline.raw"], "settings": { "foreground": "#a9bc83", "background": "#343533" } },
    { "scope": ["constant.numeric", "constant.language", "constant.character"], "settings": { "foreground": "#c58f62" } },
    { "scope": ["keyword", "storage.type", "storage.modifier"], "settings": { "foreground": "#bd8bca" } },
    { "scope": ["entity.name.function", "support.function", "meta.function-call"], "settings": { "foreground": "#d6b875" } },
    { "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class"], "settings": { "foreground": "#8fb873" } },
    { "scope": ["variable", "meta.definition.variable.name"], "settings": { "foreground": "#c8c3b8" } },
    { "scope": ["keyword.operator"], "settings": { "foreground": "#c7bdb3" } },
    { "scope": ["punctuation"], "settings": { "foreground": "#aaa49a" } },
    { "scope": ["entity.name.tag"], "settings": { "foreground": "#d6b26f" } },
    { "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#8fb873" } }
  ],
  "semanticTokenColors": {
    "type": "#8fb873",
    "class": "#8fb873",
    "interface": "#8fb873",
    "parameter": "#c8c3b8",
    "variable": "#c8c3b8",
    "property": "#c8c3b8",
    "function": "#d6b875",
    "method": "#d6b875",
    "keyword": "#bd8bca",
    "comment": { "foreground": "#a6aaa3", "italic": true },
    "string": "#a9bc83",
    "number": "#c58f62",
    "operator": "#c7bdb3",
    "decorator": "#d6b26f"
  }
}

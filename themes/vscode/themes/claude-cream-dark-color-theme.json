  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#7f857c", "fontStyle": "italic" } },
    { "scope": ["string", "constant.other.symbol"], "settings": { "foreground": "#b5c88d" } },
    { "scope": ["markup.inline.raw", "markup.inline.raw.string.markdown"], "settings": { "foreground": "#b5c88d", "background": "#2d2e2d", "fontStyle": "" } },
    { "scope": ["constant.numeric", "constant.language", "constant.character"], "settings": { "foreground": "#d19a66" } },
    { "scope": ["keyword", "storage.type", "storage.modifier"], "settings": { "foreground": "#c891d9" } },
    { "scope": ["entity.name.function", "support.function", "meta.function-call"], "settings": { "foreground": "#e5c07b" } },
    { "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class"], "settings": { "foreground": "#98c379" } },
    { "scope": ["variable", "meta.definition.variable.name"], "settings": { "foreground": "#abb2bf" } },
    { "scope": ["keyword.operator"], "settings": { "foreground": "#d6cbc0" } },
    { "scope": ["punctuation"], "settings": { "foreground": "#b8b2a8" } },
    { "scope": ["entity.name.tag"], "settings": { "foreground": "#e6bf7a" } },
    { "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#98c379" } },
    { "scope": ["markup.heading", "entity.name.section"], "settings": { "foreground": "#e6bf7a", "fontStyle": "bold" } },
    { "scope": ["markup.underline.link", "string.other.link"], "settings": { "foreground": "#75b5bc", "fontStyle": "underline" } },
    { "scope": ["markup.inserted"], "settings": { "foreground": "#9ab889" } },
    { "scope": ["markup.deleted"], "settings": { "foreground": "#ea928a" } },
    { "scope": ["constant", "entity.name.constant", "variable.other.constant", "variable.other.enummember", "variable.language"], "settings": { "foreground": "#d19a66" } },
    { "scope": ["variable.parameter.function", "meta.object.member", "meta.property-name"], "settings": { "foreground": "#abb2bf" } },
    { "scope": ["source.regexp", "string.regexp"], "settings": { "foreground": "#75b5bc" } },
    { "scope": ["string.regexp.character-class", "string.regexp constant.character.escape"], "settings": { "foreground": "#98c379", "fontStyle": "bold" } },
    { "scope": ["support.type.property-name.json"], "settings": { "foreground": "#98c379" } },
    { "scope": ["meta.module-reference"], "settings": { "foreground": "#75b5bc" } },
    { "scope": ["invalid.broken", "invalid.deprecated", "invalid.illegal", "invalid.unimplemented"], "settings": { "foreground": "#ea928a", "fontStyle": "italic" } },
    { "scope": ["punctuation.definition.list.begin.markdown"], "settings": { "foreground": "#e6bf7a" } },
    { "scope": ["markup.quote"], "settings": { "foreground": "#b5c88d", "fontStyle": "italic" } },
    { "scope": ["markup.italic"], "settings": { "foreground": "#ddd9cd", "fontStyle": "italic" } },
    { "scope": ["markup.bold"], "settings": { "foreground": "#eeeae0", "fontStyle": "bold" } },
    { "scope": ["markup.strikethrough"], "settings": { "foreground": "#bbb6a8", "fontStyle": "strikethrough" } },
    { "scope": ["markup.changed", "punctuation.definition.changed"], "settings": { "foreground": "#e6bf7a", "background": "#5a4d33" } },
    { "scope": ["markup.ignored", "markup.untracked"], "settings": { "foreground": "#8c887e" } },
    { "scope": ["meta.diff.range", "meta.diff.header"], "settings": { "foreground": "#c891d9", "fontStyle": "bold" } },
    { "scope": ["brackethighlighter.tag", "brackethighlighter.curly", "brackethighlighter.round", "brackethighlighter.square", "brackethighlighter.angle"], "settings": { "foreground": "#b8b2a8" } },
    { "scope": ["brackethighlighter.unmatched"], "settings": { "foreground": "#ea928a", "fontStyle": "bold" } }
  ],
  "semanticTokenColors": {
    "namespace": "#98c379",
    "type": "#98c379",
    "class": "#98c379",
    "interface": "#98c379",
    "parameter": "#abb2bf",
    "variable": "#abb2bf",
    "property": "#abb2bf",
    "function": "#e5c07b",
    "method": "#e5c07b",
    "keyword": "#c891d9",
    "comment": { "foreground": "#7f857c", "italic": true },
    "string": "#b5c88d",
    "number": "#d19a66",
    "regexp": "#75b5bc",
    "operator": "#d6cbc0",
    "decorator": "#e6bf7a"
  }
}

  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#756e62", "fontStyle": "italic" } },
    { "scope": ["string", "constant.other.symbol"], "settings": { "foreground": "#536b2c" } },
    { "scope": ["markup.inline.raw", "markup.inline.raw.string.markdown"], "settings": { "foreground": "#536b2c", "background": "#f8f7f2", "fontStyle": "" } },
    { "scope": ["constant.numeric", "constant.language", "constant.character"], "settings": { "foreground": "#8a5e16" } },
    { "scope": ["keyword", "storage.type", "storage.modifier"], "settings": { "foreground": "#6f3f82" } },
    { "scope": ["entity.name.function", "support.function", "meta.function-call"], "settings": { "foreground": "#8a5e16" } },
    { "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class"], "settings": { "foreground": "#4f6f2b" } },
    { "scope": ["variable", "meta.definition.variable.name"], "settings": { "foreground": "#2f3440" } },
    { "scope": ["keyword.operator"], "settings": { "foreground": "#4c463b" } },
    { "scope": ["punctuation"], "settings": { "foreground": "#5b554b" } },
    { "scope": ["entity.name.tag"], "settings": { "foreground": "#b7791f" } },
    { "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#4f6f2b" } },
    { "scope": ["markup.heading", "entity.name.section"], "settings": { "foreground": "#9f6819", "fontStyle": "bold" } },
    { "scope": ["markup.underline.link", "string.other.link"], "settings": { "foreground": "#2c6f75", "fontStyle": "underline" } },
    { "scope": ["markup.inserted"], "settings": { "foreground": "#4b6f3d" } },
    { "scope": ["markup.deleted"], "settings": { "foreground": "#7c1b13" } },
    { "scope": ["constant", "entity.name.constant", "variable.other.constant", "variable.other.enummember", "variable.language"], "settings": { "foreground": "#8a5e16" } },
    { "scope": ["variable.parameter.function", "meta.object.member", "meta.property-name"], "settings": { "foreground": "#2f3440" } },
    { "scope": ["source.regexp", "string.regexp"], "settings": { "foreground": "#2c6f75" } },
    { "scope": ["string.regexp.character-class", "string.regexp constant.character.escape"], "settings": { "foreground": "#4f6f2b", "fontStyle": "bold" } },
    { "scope": ["support.type.property-name.json"], "settings": { "foreground": "#4f6f2b" } },
    { "scope": ["meta.module-reference"], "settings": { "foreground": "#2c6f75" } },
    { "scope": ["invalid.broken", "invalid.deprecated", "invalid.illegal", "invalid.unimplemented"], "settings": { "foreground": "#7c1b13", "fontStyle": "italic" } },
    { "scope": ["punctuation.definition.list.begin.markdown"], "settings": { "foreground": "#b7791f" } },
    { "scope": ["markup.quote"], "settings": { "foreground": "#536b2c", "fontStyle": "italic" } },
    { "scope": ["markup.italic"], "settings": { "foreground": "#403d36", "fontStyle": "italic" } },
    { "scope": ["markup.bold"], "settings": { "foreground": "#302e28", "fontStyle": "bold" } },
    { "scope": ["markup.strikethrough"], "settings": { "foreground": "#6d675b", "fontStyle": "strikethrough" } },
    { "scope": ["markup.changed", "punctuation.definition.changed"], "settings": { "foreground": "#8a5e16", "background": "#eee1bd" } },
    { "scope": ["markup.ignored", "markup.untracked"], "settings": { "foreground": "#6d675b" } },
    { "scope": ["meta.diff.range", "meta.diff.header"], "settings": { "foreground": "#6f3f82", "fontStyle": "bold" } },
    { "scope": ["brackethighlighter.tag", "brackethighlighter.curly", "brackethighlighter.round", "brackethighlighter.square", "brackethighlighter.angle"], "settings": { "foreground": "#5b554b" } },
    { "scope": ["brackethighlighter.unmatched"], "settings": { "foreground": "#7c1b13", "fontStyle": "bold" } }
  ],
  "semanticTokenColors": {
    "namespace": "#4f6f2b",
    "type": "#4f6f2b",
    "class": "#4f6f2b",
    "interface": "#4f6f2b",
    "parameter": "#2f3440",
    "variable": "#2f3440",
    "property": "#2f3440",
    "function": "#8a5e16",
    "method": "#8a5e16",
    "keyword": "#6f3f82",
    "comment": { "foreground": "#756e62", "italic": true },
    "string": "#536b2c",
    "number": "#8a5e16",
    "regexp": "#2c6f75",
    "operator": "#4c463b",
    "decorator": "#b7791f"
  }
}
